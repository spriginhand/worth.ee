---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

// Declared rather than left to inference. Without this every prop below was
// `any`, which is why `post.data.reply` reading a field the content schema never
// declared compiled silently — `npm run check` has something to check now, and
// this is what lets it.
interface Props {
    title?: string;
    description?: string;
    canonical?: string;
    /** A post page, not a section page. Sets og:type=article, article:published_time, and drops the footer. */
    articlePage?: boolean;
    lang?: string;
    publishedTime?: Date;
    /** 404 only. Drops canonical, og:url and the sitemap, since /404/ is not a real path. */
    noindex?: boolean;
}

const { title = "xiaotian’s blog", description = "xiaotian’s blog — xiaotian", canonical, articlePage = false, lang = 'zh-CN', publishedTime, noindex = false } = Astro.props;
// Bump OG_IMAGE_VERSION whenever og-image.png changes. Telegram caches the
// image BY URL and re-serving the same URL does not invalidate it, so the
// version query is the only thing that forces a fresh fetch.
const OG_IMAGE_VERSION = '3';
const ogImage = `https://worth.ee/og-image.png?v=${OG_IMAGE_VERSION}`;
const pageUrl = canonical || `https://worth.ee${Astro.url.pathname}`;
const isNotHome = Astro.url.pathname !== '/';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#ffffff">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin>
    <meta name="description" content={description} />
    <meta name="author" content="xiaotian" />
    {/* A 404 is served at /404.html, so the canonical /404/ path does not
        exist. Pointing at it is a dead link, so drop canonical and noindex. */}
    {!noindex && <link rel="canonical" href={pageUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={articlePage ? 'article' : 'website'} />
    {articlePage && publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {/* Same exclusion as canonical: og:url advertises a URL, and the 404's own
        /404/ path is not one. Dropping it with the canonical is the difference
        between "this page does not exist" and a card pointing at nothing. */}
    {!noindex && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={ogImage} />
    {/* Declared so crawlers size the card without downloading the image first.
        1200x630 is the 1.91:1 that Facebook/LinkedIn/Slack expect. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="xiaotian’s blog" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    {/* X/Twitter ignores og:* entirely and only reads twitter:card, so
        without this a shared link renders as a bare URL there. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <ClientRouter fallback="none" />
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="gradient-mask"></div>
    <div class="page-wrapper">
        <main class="container" id="main-content">
            <slot />
        </main>
        {/* No footer on an article. The page already ends with the reply line,
            and a reader who got here from the index is mid-thought, not looking
            for navigation — the ← back link and back-to-top cover getting out.
            Keyed off articlePage rather than a new prop so there is one flag
            for "this is a post" and not two that can disagree. */}
        {!articlePage && (
        <footer class="site-footer">
            <p class="footer-nav">
                <a href="/">Index</a><span class="sep">·</span><a href="/about/">About</a><span class="sep">·</span><a href="/privacy/">Privacy</a>
            </p>
            <p class="copyright">© xiaotian</p>
        </footer>
        )}
    </div>

    {/* The wrapper is conditional, not just its contents: on the index this
        rendered `<div id="info-tools"></div>` — a position:fixed element with
        nothing in it, on the most-viewed page. */}
    {isNotHome && (
    <div id="info-tools">
        <a href="/" class="info-tool" aria-label="Back to index">←</a>
    </div>
    )}

    <button class="info-tool back-to-top" aria-label="Back to top">
        <svg viewBox="0 0 24 24"><path d="M18 15l-6-6-6 6"/></svg>
    </button>

    <script is:inline>
    (function(){
        var r=false;
        // Cached per page load, not per frame. scrollHeight is a
        // forced-layout read: asking for it inside the rAF callback makes the
        // browser recompute layout, then the classList/style writes below
        // dirty it again — a read/write thrash on every scroll frame. The
        // document height cannot change between navigations, so once is enough
        // and init() re-runs on astro:page-load to refresh it.
        var maxScroll = 0;
        function measure(){
            maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        }
        function bind(){
            // Reset the throttle flag here, not in onScroll: leaving it latched
            // means r stays true forever after the first event and every later
            // scroll is ignored, so the button can never appear.
            r=false;
            var y=window.scrollY;
            var btt=document.querySelector('.back-to-top');
            var gm=document.querySelector('.gradient-mask');
            if(btt){
                // Threshold adapts to the page: a short index may only scroll
                // ~130px, so a fixed y>300 could never fire. Show the button
                // once the user is most of the way through whatever scroll
                // distance exists, but not on pages that barely scroll at all.
                btt.classList.toggle('is-visible', maxScroll>120 && y>Math.min(300, maxScroll*0.5));
            }
            if(gm)gm.style.opacity=y>=64?'1':'0';
        }
        function onScroll(){if(!r){r=true;requestAnimationFrame(bind)}}
        window.addEventListener('scroll',onScroll,{passive:true});

        // Re-run on every client-side navigation so maxScroll is re-measured
        // for the swapped-in document.
        function init(){
            r=false; measure(); bind();
            var btt=document.querySelector('.back-to-top');
            if(btt && !btt.dataset.bound){
                btt.dataset.bound='1';
                btt.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'})});
            }
        }
        init();
        document.addEventListener('astro:page-load', init);
    })();
    </script>
</body>
</html>