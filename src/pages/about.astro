---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" lang="en">
    <article class="post-content">
        <h1>About</h1>
        <p>I am xiaotian. This is my blog. The content of this site is written by myself, not through AI.</p>
        {/* Both addresses live here rather than in the footer. The footer is an
            index of the site; who to write to is a fact about the author, and it
            belongs with the rest of that. It also keeps each channel to one
            place — the end of every post already carries its own reply line,
            pre-filled with that post's title.

            "contact:" is a real <h2>, not a styled paragraph. It is a heading
            on this page in exactly the way "Fonts" and "Hosting" are headings on
            /privacy, and the two should not be two different kinds of thing —
            this used to be a <p> carrying its own colour and spacing, which is
            why it never quite matched the section headings elsewhere. Now it
            inherits .post-content h2 and there is no local rule for it at all. */}
        <h2>contact:</h2>
        {/* The whole row is the link, not just the address. This is the answer to
            "how does a reader know it is clickable" without putting an underline
            back: the signal is the row lighting up, which is a different channel
            from colour weight or a rule under the text. It also enlarges the
            target — the address alone was a short, thin line to hit on a phone.

            The name and the address are both inside the <a>, which is why the
            grid can no longer live on the wrapper with display:contents rows:
            an <a> is a single box now. Instead each row is its own grid with a
            shared column width, set once in --channel-col from the wider label. */}
        <a class="channel" href="mailto:a@worth.ee">
            <span class="channel-name">mail:</span>
            {/* The @ is set small. At full size it is a 15px circle beside a 9px
                lowercase a, and it sits at the visual centre of the row while the
                letters around it sit on the baseline — so the address read as
                starting further right than it did, even though both rows began at
                the same x. One step down it stops competing with the row.

                The domain is not dimmed, and neither is t.me/ below. Splitting an
                address into "where to go" and "who it is for" was tried and is
                not worth it: both halves have to be read to use the address, and
                the block reads as one label with a value. */}
            <span class="channel-address">a<span class="at">@</span>worth.ee</span>
        </a>
        <a class="channel" href="https://t.me/spriginhand" rel="me noopener" target="_blank">
            <span class="channel-name">telegram:</span>
            {/* Shown as t.me/spriginhand rather than @spriginhand. The @ was
                tried both ways: stripped entirely, and kept at full size, and
                both read wrong — the leading circle is wider than anything else
                that can start an address here, which knocked the visual start
                out of line with the mail row. t.me/ is lowercase, begins with a
                t as most handles do, is what the reader would type to reach the
                page, and needs no size override to sit level with the letters
                after it. The mail row's @ stays small for the same reason. */}
            <span class="channel-address">t.me/spriginhand</span>
        </a>
    </article>
</BaseLayout>

<style>
    /* Each row names a channel and gives the address that reaches it. The whole
       row is the link, so the hit area is a line rather than a few characters.

       Hover lights the ADDRESS, not the row. Washing the row would make
       "mail:" look like part of the hit area, and the label is not the thing
       you are aiming at — you read it to know which address the link is. The
       label holds its prose colour throughout and only the value responds,
       which is also what tells you where the click target starts and ends
       without a rule under the text. */
    .channel {
        /* A fixed column so the two rows line up without a wrapper grid. 6.2em
           fits "telegram:" at 16px plus the gap; it is deliberately not
           max-content, which would size per row and knock the addresses out of
           alignment by the difference in label width. */
        display: grid;
        grid-template-columns: 6.2em auto;
        column-gap: .6em;
        align-items: baseline;
        width: fit-content;
        margin: 0;
        padding: 0;
        color: var(--text-secondary);
        text-decoration: none;
    }
    /* The wash is on the address span, so the padding that gives the wash room
       to breathe lives there too — and a negative margin pulls its left edge
       back under the column-gap, so the block starts flush with the text above
       rather than sitting a half-gem in. */
    .channel-address {
        margin: 0 -8px;
        padding: 2px 8px;
        border-radius: 3px;
        transition: background-color .15s ease, color .15s ease;
    }
    .channel-address:hover {
        background-color: oklch(96% 0 0);
        color: var(--text-primary);
    }
    /* A visible ring for keyboard focus. The address carries the visual hit
       area, so the ring goes on it rather than the row, matching what a mouse
       user sees light up. */
    .channel:focus-visible { outline: none; }
    .channel:focus-visible .channel-address {
        outline: 2px solid var(--grey7);
        outline-offset: 1px;
    }
    /* The mail address's @ is set one step down. At full size it is a circle
       15px across beside a 9px lowercase a and it sits centred on the row while
       the letters sit on the baseline, so it pulled the eye right and the two
       addresses looked like they began at different x. Small, it stays part of
       the word; the tiny right margin keeps "worth.ee" from crowding it. */
    .at {
        font-size: .8em;
        margin-right: .06em;
    }
    /* The domain is held back a step from the name it points at. Both rows are
       addresses, and both carry two parts: somewhere to send it, and who it is
       for — t.me/ and worth.ee. Dimming the first part in each row lets the eye
       land on the identifier, and it ties back to the footer's separator, which
       is the same muted grey. Same grey on both rows, so the two keep matching. */
    .tme,
    .domain { color: var(--text-tertiary); }
    /* Sits directly against the name it precedes, so it gets no extra gap — the
       dimming already separates it, and a margin would open a hole. */
    .tme, .domain { margin-right: .06em; }
</style>
