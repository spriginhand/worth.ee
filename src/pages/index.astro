---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft);
// Sorted newest-first. Content collections make no ordering promise, so the
// order the index reads in has to be asked for explicitly.
const sorted = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Grouped by year, descending. The year is printed once at the head of its
// group rather than on every row: it is the slowest-varying fact in the list,
// and repeating it N times is what makes a date column feel heavy. Within a
// group, entries keep newest-first order.
const byYear: { year: number; posts: typeof sorted }[] = [];
for (const post of sorted) {
    const year = post.data.date.getUTCFullYear();
    const last = byYear[byYear.length - 1];
    if (last && last.year === year) last.posts.push(post);
    else byYear.push({ year, posts: [post] });
}

// Month and day, digits only. The year is already the group heading, so
// repeating it on every row spends width the title needs; and a numeric
// "09/29" is narrower than "Sep 29" and needs no translation to read. The
// slash is the ISO-ish date separator: two two-digit numbers split by an
// oblique line cannot be misread the way "09.29" can be — a period there looks
// like a decimal point, which is how 2.5 and v1.09.29 are written.
// UTC getters throughout, deliberately. A frontmatter `date: 2026-09-29` parses
// to UTC midnight, so the LOCAL getMonth()/getDate() read the previous day
// anywhere west of UTC — measured: the same post renders `09/28` under
// TZ=America/Los_Angeles and `09/29` under TZ=UTC. That also desynchronised the
// visible date from the <time datetime> attribute, which was already correct
// because it uses toISOString(). A post dated 2026-01-01 built on a US worker
// would land in the 2025 group. UTC is what the frontmatter means.
const fmtDate = (d: Date) =>
    `${String(d.getUTCMonth() + 1).padStart(2, '0')}/${String(d.getUTCDate()).padStart(2, '0')}`;
// Strips Markdown syntax and HTML entities for the excerpt. The `?? ''` is
// because the glob loader types `body` as possibly undefined; a post with no
// body renders an empty excerpt rather than failing the build. These regexes only
// ever see this site's own Markdown — nothing arbitrary is rendered — so this
// is a display convenience, not a sanitiser. `&#39;` goes first so the `&` it
// introduces is not re-escaped by the named pass below.
const stripTags = (md: string) => md
    .replace(/<[^>]*>/g, '')
    .replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/^>\s?/gm, '')
    .replace(/(\*\*|__|\*|_)(.+?)\1/g, '$2')
    .replace(/`([^`]*)`/g, '$1')
    .replace(/&#39;/g, "'")
    .replace(/&quot;/g, '"')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&amp;/g, '&')
    .replace(/\s+/g, ' ')
    .trim();
---

<BaseLayout>
    {/* The index is deliberately just a list, but it still needs one h1 for
        screen readers and heading structure. Hidden visually, not removed. */}
    <h1 class="visually-hidden">文章</h1>
    <div class="post-archive">
        {byYear.map(group => (
            <section class="year-group">
                <h2 class="year-label">{group.year}</h2>
                <ul class="post-list">
                    {group.posts.map(post => (
                        <li class="post-item">
                            <a href={`/posts/${post.id}/`} class="post-link">
                                <p class="post-title">{post.data.title}</p>
                                <time class="post-date" datetime={post.data.date.toISOString().slice(0, 10)}>{fmtDate(post.data.date)}</time>
                                <p class="post-excerpt">{stripTags(post.body ?? '').slice(0, 120)}</p>
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        ))}
    </div>
</BaseLayout>